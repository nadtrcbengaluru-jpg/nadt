rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // GLOBAL HELPER PRIMITIVES
    // ------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBookingRef(ref) {
      return ref is string && ref.size() >= 8 && ref.size() <= 48 && ref.matches('^NADT-BLR-[0-9]{8}-[A-Z0-9]{4,8}$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email == 'nadtrc.bengaluru@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN' &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.is_active == true
        )
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'] &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.is_active == true
      );
    }

    // ------------------------------------------------------------------------
    // ENTITY VALIDATION BLUEPRINTS
    // ------------------------------------------------------------------------
    function isValidRoom(data) {
      return data.keys().hasAll([
          'room_id', 'room_number', 'floor_id', 'floor_name', 'category_id',
          'category_name', 'bed_type', 'ac_type', 'capacity', 'building_allocation',
          'status', 'is_active', 'verification_status', 'remarks', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'room_id', 'room_number', 'floor_id', 'floor_name', 'category_id',
          'category_name', 'bed_type', 'ac_type', 'capacity', 'building_allocation',
          'status', 'is_active', 'verification_status', 'remarks', 'created_at', 'updated_at'
        ]) &&
        isValidId(data.room_id) &&
        data.room_number is string && data.room_number.size() >= 1 && data.room_number.size() <= 32 &&
        isValidId(data.floor_id) &&
        data.floor_name is string && data.floor_name.size() >= 1 && data.floor_name.size() <= 80 &&
        isValidId(data.category_id) &&
        data.category_name is string && data.category_name.size() >= 1 && data.category_name.size() <= 100 &&
        data.bed_type in ['Single', 'Double', 'Queen Size', 'VIP', 'Pending Verification'] &&
        data.ac_type in ['AC', 'Non-AC', 'Pending Verification'] &&
        data.capacity is int && data.capacity >= 1 && data.capacity <= 20 &&
        data.building_allocation in ['GENERAL', 'CR_BUILDING'] &&
        data.status in ['AVAILABLE', 'BOOKED', 'OCCUPIED', 'UNDER MAINTENANCE', 'RESERVED', 'ALLOCATED TO CR BUILDING', 'INACTIVE'] &&
        data.is_active is bool &&
        data.verification_status in ['VERIFIED', 'PENDING_VERIFICATION'] &&
        data.remarks is string && data.remarks.size() <= 500 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidFloor(data) {
      return data.keys().hasAll(['floor_id', 'floor_number', 'floor_name', 'description', 'display_order', 'is_active', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['floor_id', 'floor_number', 'floor_name', 'description', 'display_order', 'is_active', 'created_at', 'updated_at']) &&
        isValidId(data.floor_id) &&
        data.floor_number is int && data.floor_number >= 0 && data.floor_number <= 50 &&
        data.floor_name is string && data.floor_name.size() >= 1 && data.floor_name.size() <= 80 &&
        data.description is string && data.description.size() <= 300 &&
        data.display_order is int && data.display_order >= 0 && data.display_order <= 100 &&
        data.is_active is bool &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['category_id', 'category_name', 'bed_type', 'ac_type', 'default_capacity', 'description', 'is_bookable', 'display_order', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['category_id', 'category_name', 'bed_type', 'ac_type', 'default_capacity', 'description', 'is_bookable', 'display_order', 'created_at', 'updated_at']) &&
        isValidId(data.category_id) &&
        data.category_name is string && data.category_name.size() >= 1 && data.category_name.size() <= 100 &&
        data.bed_type in ['Single', 'Double', 'Queen Size', 'VIP', 'Pending Verification'] &&
        data.ac_type in ['AC', 'Non-AC', 'Pending Verification'] &&
        data.default_capacity is int && data.default_capacity >= 1 && data.default_capacity <= 20 &&
        data.description is string && data.description.size() <= 300 &&
        data.is_bookable is bool &&
        data.display_order is int && data.display_order >= 0 && data.display_order <= 100 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidAllocation(data) {
      return data.keys().hasAll(['allocation_id', 'room_id', 'room_number', 'allocation_type', 'allocated_to', 'is_publicly_bookable', 'effective_from', 'effective_to', 'remarks', 'updated_by', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['allocation_id', 'room_id', 'room_number', 'allocation_type', 'allocated_to', 'is_publicly_bookable', 'effective_from', 'effective_to', 'remarks', 'updated_by', 'created_at', 'updated_at']) &&
        isValidId(data.allocation_id) &&
        isValidId(data.room_id) &&
        data.room_number is string && data.room_number.size() >= 1 && data.room_number.size() <= 32 &&
        data.allocation_type in ['GENERAL', 'CR_BUILDING'] &&
        data.allocated_to is string && data.allocated_to.size() <= 120 &&
        data.is_publicly_bookable is bool &&
        data.effective_from is string && data.effective_from.size() <= 32 &&
        data.effective_to is string && data.effective_to.size() <= 32 &&
        data.remarks is string && data.remarks.size() <= 500 &&
        data.updated_by is string && data.updated_by.size() <= 160 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidBookingShape(data) {
      return data.keys().hasAll([
          'booking_id', 'booking_ref', 'applicant_name', 'organization', 'designation',
          'email', 'mobile', 'purpose', 'check_in_date', 'check_out_date',
          'num_persons', 'preferred_category', 'rooms_required', 'assigned_room_ids',
          'assigned_room_numbers', 'special_requirements', 'applicant_remarks',
          'admin_remarks', 'status', 'reviewed_by', 'reviewed_at', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'booking_id', 'booking_ref', 'applicant_name', 'organization', 'designation',
          'email', 'mobile', 'purpose', 'check_in_date', 'check_out_date',
          'num_persons', 'preferred_category', 'rooms_required', 'assigned_room_ids',
          'assigned_room_numbers', 'special_requirements', 'applicant_remarks',
          'admin_remarks', 'status', 'reviewed_by', 'reviewed_at', 'created_at', 'updated_at'
        ]) &&
        isValidId(data.booking_id) &&
        isValidBookingRef(data.booking_ref) &&
        data.applicant_name is string && data.applicant_name.size() >= 1 && data.applicant_name.size() <= 120 &&
        data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 160 &&
        data.designation is string && data.designation.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.mobile is string && data.mobile.size() >= 5 && data.mobile.size() <= 30 &&
        data.purpose is string && data.purpose.size() >= 1 && data.purpose.size() <= 300 &&
        data.check_in_date is string && data.check_in_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.check_out_date is string && data.check_out_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.check_in_date < data.check_out_date &&
        data.num_persons is int && data.num_persons >= 1 && data.num_persons <= 100 &&
        data.preferred_category is string && data.preferred_category.size() >= 1 && data.preferred_category.size() <= 100 &&
        data.rooms_required is int && data.rooms_required >= 1 && data.rooms_required <= 50 &&
        data.assigned_room_ids is list && data.assigned_room_ids.size() <= 30 &&
        (data.assigned_room_ids.size() == 0 || data.assigned_room_ids[0] is string) &&
        data.assigned_room_numbers is list && data.assigned_room_numbers.size() <= 30 &&
        (data.assigned_room_numbers.size() == 0 || data.assigned_room_numbers[0] is string) &&
        data.special_requirements is string && data.special_requirements.size() <= 500 &&
        data.applicant_remarks is string && data.applicant_remarks.size() <= 500 &&
        data.admin_remarks is string && data.admin_remarks.size() <= 500 &&
        data.status in ['PENDING', 'APPROVED', 'REJECTED', 'CANCELLED', 'CHECKED-IN', 'CHECKED-OUT'] &&
        data.reviewed_by is string && data.reviewed_by.size() <= 160 &&
        data.reviewed_at is string && data.reviewed_at.size() <= 64 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidPublicBookingCreate(data) {
      return isValidBookingShape(data) &&
        data.status == 'PENDING' &&
        data.assigned_room_ids.size() == 0 &&
        data.assigned_room_numbers.size() == 0 &&
        data.admin_remarks.size() == 0 &&
        data.reviewed_by.size() == 0 &&
        data.reviewed_at.size() == 0 &&
        data.created_at == request.time &&
        data.updated_at == request.time;
    }

    function isValidBookingStatusCard(data) {
      return data.keys().hasAll([
          'booking_ref', 'booking_id', 'status', 'check_in_date', 'check_out_date',
          'preferred_category', 'rooms_required', 'assigned_room_numbers',
          'admin_remarks', 'reviewed_at', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'booking_ref', 'booking_id', 'status', 'check_in_date', 'check_out_date',
          'preferred_category', 'rooms_required', 'assigned_room_numbers',
          'admin_remarks', 'reviewed_at', 'created_at', 'updated_at'
        ]) &&
        isValidBookingRef(data.booking_ref) &&
        isValidId(data.booking_id) &&
        data.status in ['PENDING', 'APPROVED', 'REJECTED', 'CANCELLED', 'CHECKED-IN', 'CHECKED-OUT'] &&
        data.check_in_date is string && data.check_in_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.check_out_date is string && data.check_out_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.check_in_date < data.check_out_date &&
        data.preferred_category is string && data.preferred_category.size() >= 1 && data.preferred_category.size() <= 100 &&
        data.rooms_required is int && data.rooms_required >= 1 && data.rooms_required <= 50 &&
        data.assigned_room_numbers is list && data.assigned_room_numbers.size() <= 30 &&
        (data.assigned_room_numbers.size() == 0 || data.assigned_room_numbers[0] is string) &&
        data.admin_remarks is string && data.admin_remarks.size() <= 500 &&
        data.reviewed_at is string && data.reviewed_at.size() <= 64 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['admin_id', 'email', 'full_name', 'role', 'is_active', 'last_login_at', 'created_by', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['admin_id', 'email', 'full_name', 'role', 'is_active', 'last_login_at', 'created_by', 'created_at', 'updated_at']) &&
        isValidId(data.admin_id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'ADMIN'] &&
        data.is_active is bool &&
        data.last_login_at is string && data.last_login_at.size() <= 64 &&
        data.created_by is string && data.created_by.size() <= 160 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'site_title', 'site_subtitle', 'logo_url', 'hero_heading', 'hero_description',
          'campus_address', 'contact_email', 'contact_phone', 'check_in_time',
          'check_out_time', 'booking_guidelines', 'footer_text',
          'show_designation', 'show_purpose', 'show_special_requirements',
          'show_applicant_remarks', 'updated_by', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'site_title', 'site_subtitle', 'logo_url', 'hero_heading', 'hero_description',
          'campus_address', 'contact_email', 'contact_phone', 'check_in_time',
          'check_out_time', 'booking_guidelines', 'footer_text',
          'show_designation', 'show_purpose', 'show_special_requirements',
          'show_applicant_remarks', 'updated_by', 'updated_at'
        ]) &&
        data.site_title is string && data.site_title.size() <= 140 &&
        data.site_subtitle is string && data.site_subtitle.size() <= 180 &&
        data.logo_url is string && data.logo_url.size() <= 120000 &&
        data.hero_heading is string && data.hero_heading.size() <= 200 &&
        data.hero_description is string && data.hero_description.size() <= 800 &&
        data.campus_address is string && data.campus_address.size() <= 300 &&
        data.contact_email is string && data.contact_email.size() <= 160 &&
        data.contact_phone is string && data.contact_phone.size() <= 60 &&
        data.check_in_time is string && data.check_in_time.size() <= 40 &&
        data.check_out_time is string && data.check_out_time.size() <= 40 &&
        data.booking_guidelines is string && data.booking_guidelines.size() <= 1000 &&
        data.footer_text is string && data.footer_text.size() <= 200 &&
        data.show_designation is bool &&
        data.show_purpose is bool &&
        data.show_special_requirements is bool &&
        data.show_applicant_remarks is bool &&
        data.updated_by is string && data.updated_by.size() <= 160 &&
        data.updated_at is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['announcement_id', 'title', 'content', 'priority', 'is_active', 'starts_at', 'ends_at', 'created_by', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['announcement_id', 'title', 'content', 'priority', 'is_active', 'starts_at', 'ends_at', 'created_by', 'created_at', 'updated_at']) &&
        isValidId(data.announcement_id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 800 &&
        data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT'] &&
        data.is_active is bool &&
        data.starts_at is string && data.starts_at.size() <= 64 &&
        data.ends_at is string && data.ends_at.size() <= 64 &&
        data.created_by is string && data.created_by.size() <= 160 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['log_id', 'actor_id', 'actor_email', 'actor_role', 'action', 'entity_type', 'entity_id', 'details_summary', 'created_at']) &&
        data.keys().hasOnly(['log_id', 'actor_id', 'actor_email', 'actor_role', 'action', 'entity_type', 'entity_id', 'details_summary', 'created_at']) &&
        isValidId(data.log_id) &&
        data.actor_id is string && data.actor_id.size() <= 128 &&
        data.actor_email is string && data.actor_email.size() <= 160 &&
        data.actor_role is string && data.actor_role.size() <= 32 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.entity_type is string && data.entity_type.size() >= 1 && data.entity_type.size() <= 64 &&
        data.entity_id is string && data.entity_id.size() <= 128 &&
        data.details_summary is string && data.details_summary.size() <= 800 &&
        data.created_at is timestamp;
    }

    function isValidMaintenanceSchedule(data) {
      return data.keys().hasAll([
          'schedule_id', 'room_id', 'room_number', 'floor_name', 'title',
          'maintenance_type', 'priority', 'scheduled_date', 'end_date',
          'status', 'assigned_to', 'notes', 'created_by', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'schedule_id', 'room_id', 'room_number', 'floor_name', 'title',
          'maintenance_type', 'priority', 'scheduled_date', 'end_date',
          'status', 'assigned_to', 'notes', 'created_by', 'created_at', 'updated_at'
        ]) &&
        isValidId(data.schedule_id) &&
        isValidId(data.room_id) &&
        data.room_number is string && data.room_number.size() >= 1 && data.room_number.size() <= 32 &&
        data.floor_name is string && data.floor_name.size() >= 1 && data.floor_name.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.maintenance_type in ['Electrical', 'Plumbing', 'HVAC / AC', 'Housekeeping', 'Furniture & Civil', 'Inspection'] &&
        data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT'] &&
        data.scheduled_date is string && data.scheduled_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.end_date is string && data.end_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.scheduled_date <= data.end_date &&
        data.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] &&
        data.assigned_to is string && data.assigned_to.size() <= 120 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.created_by is string && data.created_by.size() <= 160 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    // ------------------------------------------------------------------------
    // COLLECTION RULES
    // ------------------------------------------------------------------------

    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    match /rooms/{roomId} {
      allow get: if isValidId(roomId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().room_id == roomId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isAdmin();
      allow update: if isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().room_id == existing().room_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'room_number', 'floor_id', 'floor_name', 'category_id', 'category_name',
          'bed_type', 'ac_type', 'capacity', 'building_allocation', 'status',
          'is_active', 'verification_status', 'remarks', 'updated_at'
        ]) &&
        isAdmin();
      allow delete: if isValidId(roomId) && isSuperAdmin();
    }

    match /floors/{floorId} {
      allow get: if isValidId(floorId);
      allow list: if true;
      allow create: if isValidId(floorId) &&
        isValidFloor(incoming()) &&
        incoming().floor_id == floorId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isSuperAdmin();
      allow update: if isValidId(floorId) &&
        isValidFloor(incoming()) &&
        incoming().floor_id == existing().floor_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'floor_number', 'floor_name', 'description', 'display_order', 'is_active', 'updated_at'
        ]) &&
        isSuperAdmin();
      allow delete: if false;
    }

    match /room_categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().category_id == categoryId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isSuperAdmin();
      allow update: if isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().category_id == existing().category_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'category_name', 'bed_type', 'ac_type', 'default_capacity', 'description',
          'is_bookable', 'display_order', 'updated_at'
        ]) &&
        isSuperAdmin();
      allow delete: if false;
    }

    match /room_allocations/{allocationId} {
      allow get: if isValidId(allocationId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(allocationId) &&
        isValidAllocation(incoming()) &&
        incoming().allocation_id == allocationId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        exists(/databases/$(database)/documents/rooms/$(incoming().room_id)) &&
        isAdmin();
      allow update: if isValidId(allocationId) &&
        isValidAllocation(incoming()) &&
        incoming().allocation_id == existing().allocation_id &&
        incoming().room_id == existing().room_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'room_number', 'allocation_type', 'allocated_to', 'is_publicly_bookable',
          'effective_from', 'effective_to', 'remarks', 'updated_by', 'updated_at'
        ]) &&
        isAdmin();
      allow delete: if isValidId(allocationId) && isSuperAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(bookingId) &&
        incoming().booking_id == bookingId &&
        isValidPublicBookingCreate(incoming());
      allow update: if isValidId(bookingId) &&
        isValidBookingShape(incoming()) &&
        incoming().booking_id == existing().booking_id &&
        incoming().booking_ref == existing().booking_ref &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'applicant_name', 'organization', 'designation', 'email', 'mobile',
          'purpose', 'check_in_date', 'check_out_date', 'num_persons',
          'preferred_category', 'rooms_required', 'assigned_room_ids',
          'assigned_room_numbers', 'special_requirements', 'applicant_remarks',
          'admin_remarks', 'status', 'reviewed_by', 'reviewed_at', 'updated_at'
        ]) &&
        isAdmin();
      allow delete: if isValidId(bookingId) && isSuperAdmin();
    }

    match /booking_status_cards/{bookingRef} {
      // Zero-PII single-document lookup by exact booking reference only; list is strictly admin-only
      allow get: if isValidBookingRef(bookingRef);
      allow list: if isAdmin();
      allow create: if isValidBookingRef(bookingRef) &&
        isValidBookingStatusCard(incoming()) &&
        incoming().booking_ref == bookingRef &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        (
          (
            incoming().status == 'PENDING' &&
            incoming().assigned_room_numbers.size() == 0 &&
            incoming().admin_remarks.size() == 0 &&
            incoming().reviewed_at.size() == 0 &&
            existsAfter(/databases/$(database)/documents/bookings/$(incoming().booking_id)) &&
            getAfter(/databases/$(database)/documents/bookings/$(incoming().booking_id)).data.booking_ref == bookingRef
          ) ||
          (
            isAdmin() &&
            exists(/databases/$(database)/documents/bookings/$(incoming().booking_id))
          )
        );
      allow update: if isValidBookingRef(bookingRef) &&
        isValidBookingStatusCard(incoming()) &&
        incoming().booking_ref == existing().booking_ref &&
        incoming().booking_id == existing().booking_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'check_in_date', 'check_out_date', 'preferred_category',
          'rooms_required', 'assigned_room_numbers', 'admin_remarks',
          'reviewed_at', 'updated_at'
        ]) &&
        isAdmin();
      allow delete: if isValidBookingRef(bookingRef) && isSuperAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isSuperAdmin();
      allow create: if isValidId(adminId) &&
        isValidAdminUser(incoming()) &&
        incoming().admin_id == adminId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isSuperAdmin();
      allow update: if isValidId(adminId) &&
        isValidAdminUser(incoming()) &&
        incoming().admin_id == existing().admin_id &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().created_by == existing().created_by &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        !(existing().role == 'SUPER_ADMIN' && incoming().is_active == false) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'full_name', 'is_active', 'last_login_at', 'updated_at'
        ]) &&
        (
          isSuperAdmin() ||
          (
            isAdmin() &&
            request.auth.uid == adminId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['last_login_at', 'updated_at'])
          )
        );
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(settingId) &&
        isValidSiteSettings(incoming()) &&
        incoming().updated_at == request.time &&
        isSuperAdmin();
      allow update: if isValidId(settingId) &&
        isValidSiteSettings(incoming()) &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'site_title', 'site_subtitle', 'logo_url', 'hero_heading', 'hero_description',
          'campus_address', 'contact_email', 'contact_phone', 'check_in_time',
          'check_out_time', 'booking_guidelines', 'footer_text',
          'show_designation', 'show_purpose', 'show_special_requirements',
          'show_applicant_remarks', 'updated_by', 'updated_at'
        ]) &&
        isSuperAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (existing().is_active == true || isSuperAdmin());
      allow list: if resource.data.is_active == true || isSuperAdmin();
      allow create: if isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().announcement_id == announcementId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isSuperAdmin();
      allow update: if isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().announcement_id == existing().announcement_id &&
        incoming().created_by == existing().created_by &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'content', 'priority', 'is_active', 'starts_at', 'ends_at', 'updated_at'
        ]) &&
        isSuperAdmin();
      allow delete: if isValidId(announcementId) && isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().log_id == logId &&
        incoming().created_at == request.time &&
        isAdmin();
      allow update, delete: if false;
    }

    match /maintenance_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(scheduleId) &&
        isValidMaintenanceSchedule(incoming()) &&
        incoming().schedule_id == scheduleId &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        exists(/databases/$(database)/documents/rooms/$(incoming().room_id)) &&
        isAdmin();
      allow update: if isValidId(scheduleId) &&
        isValidMaintenanceSchedule(incoming()) &&
        incoming().schedule_id == existing().schedule_id &&
        incoming().room_id == existing().room_id &&
        incoming().created_by == existing().created_by &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'room_number', 'floor_name', 'title', 'maintenance_type', 'priority',
          'scheduled_date', 'end_date', 'status', 'assigned_to', 'notes', 'updated_at'
        ]) &&
        isAdmin();
      allow delete: if isValidId(scheduleId) && isSuperAdmin();
    }
  }
}
